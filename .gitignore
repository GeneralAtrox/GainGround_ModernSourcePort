# Source-only repository: keep private ROMs, captures, media and research local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/NOTICE.md
!/native/
/native/*
!/native/CMakeLists.txt
!/native/README.md
!/native/include/
!/native/src/
!/native/generated/
!/native/tests/
!/native/third_party/
/native/generated/gground_game_definitions.cpp
!/scripts/
/scripts/*
!/scripts/Build-Source.ps1
!/scripts/Test-RomImport.py
!/scripts/Audit-SourcePackage.py
!/docs/
/docs/*
!/docs/source-release.md
# Never add local asset payloads or build products beneath source directories.
*.bin
*.img
*.key
*.ic1
*.ic2
*.pcm
*.wav
*.mp3
*.png
*.bmp
*.ico
*.zip
*.exe
*.dll
*.obj
*.o
*.a
*.ggcap
*.ggfz
*.ggfx
__pycache__/
